# 复制此文件为 .dev.vars 并填入真实值
# .dev.vars 已在 .gitignore 中，不会被提交

# GitHub OAuth App 凭据 (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth 凭据 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 微信开放平台 网站应用凭据 (https://open.weixin.qq.com)
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# QQ互联 网站应用凭据 (https://connect.qq.com)
QQ_APP_ID=your_qq_app_id
QQ_APP_KEY=your_qq_app_key

# JWT 签名密钥（请使用随机字符串）
JWT_SECRET=your_jwt_secret_at_least_32_chars_long
