{
	"$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
	"name": "login-demo",
	"main": "src/index.js",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"vars": {
		"GITHUB_CLIENT_ID": "",
		"GITHUB_CLIENT_SECRET": "",
		"GOOGLE_CLIENT_ID": "",
		"GOOGLE_CLIENT_SECRET": "",
		"WECHAT_APP_ID": "",
		"WECHAT_APP_SECRET": "",
		"QQ_APP_ID": "",
		"QQ_APP_KEY": "",
		"JWT_SECRET": ""
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "USER_KV",
			"id": "6438584b3ea545c6a1ef2a4ccb9be26b",
			"remote": true
		}
	]
}